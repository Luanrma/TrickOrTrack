# npm run setup creates .env.local and generates an administrator password.
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
APP_DEMO_MODE=true
ADMIN_EMAIL=admin@trickortrack.local
ADMIN_PASSWORD=
# Empty: embedded PostgreSQL, persisted to .data/pglite-demo (demo) or .data/pglite (real). External PostgreSQL:
DATABASE_URL=
PGLITE_PATH=
# Required only for the real map / real addresses. Separate restricted keys.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_GEOCODING_KEY=
