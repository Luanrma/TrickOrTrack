{
  "name": "trick-or-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node --import tsx scripts/setup.ts",
    "dev": "npm run setup && node --import tsx server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node --import tsx scripts/load-test.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@googlemaps/js-api-loader": "^2.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  }
}
